# Shared Jenkins — environment for docker-compose + JCasC (casc.yaml).
# Copy to `.env` on the Jenkins host and fill in real values. NEVER commit `.env`.
# Multi-line values (SSH keys) must be provided as the host shell/compose expects.
#
# Jenkins runs on EC2 at http://18.181.56.52:8080 (Elastic IP, Tokyo).

# --- Jenkins admin ---
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
# For reference / external tooling only (not consumed by the container):
JENKINS_URL=http://18.181.56.52:8080

# --- AWS (ECR push/pull) — shared across projects ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-1

# --- GitHub (SCM checkout) — shared across projects ---
GITHUB_USER=
GITHUB_TOKEN=

# ============================================================
# Telephony project
# ============================================================
# Override the app repo URL (defaults to the Telephony-Service repo in casc.yaml).
TELEPHONY_REPO_URL=https://github.com/Centre-for-Open-Societal-Systems/Telephony-Service.git
# SSH key + kubeconfig for the telephony deploy targets.
SSH_PRIVATE_KEY=
KUBECONFIG_CONTENT=

# ============================================================
# agri-catalogue-service (OAS) project
# ============================================================
# DB username MUST equal service.config.yaml database.username (oas_user).
OAS_DB_USERNAME=oas_user
OAS_DB_PASSWORD=
# ES security is disabled for UAT — blank is fine (the app sends empties, ES ignores).
OAS_ES_USERNAME=
OAS_ES_PASSWORD=
# Raw PEM of the OAS K8s node SSH key (OAS-Infra terraform: oas-key.pem). NOT base64.
OAS_NODE_SSH_PRIVATE_KEY=
# Optional; defaults to the Open-Agri-Stack OAS-Infra repo if unset.
OAS_INFRA_REPO_URL=https://github.com/Open-Agri-Stack/OAS-Infra.git
